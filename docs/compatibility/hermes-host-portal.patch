diff --git a/agent/auxiliary_fallback_policy.py b/agent/auxiliary_fallback_policy.py
new file mode 100644
index 00000000000..33a3b7259e1
--- /dev/null
+++ b/agent/auxiliary_fallback_policy.py
@@ -0,0 +1,121 @@
+"""Trusted fallback policy for plugin-registered auxiliary tasks.
+
+The policy is registration metadata (``PluginContext.register_auxiliary_task``),
+never part of the user-writable ``auxiliary.<task>`` block, so a config edit
+cannot widen a strict task back onto ambient recovery.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping as ABCMapping
+from typing import Any, Iterable, Mapping, Optional
+
+NATIVE = "native"
+CONFIGURED_ONLY = "configured_only"
+
+_ALIASES = {NATIVE: NATIVE, "default": NATIVE, CONFIGURED_ONLY: CONFIGURED_ONLY}
+
+
+class InvalidFallbackPolicyError(ValueError):
+    """Registration metadata carries a policy value the host will not trust."""
+
+
+def normalize_fallback_policy(value: Any) -> Optional[str]:
+    """Canonical policy for a registration value, or ``None`` when invalid."""
+    if isinstance(value, str):
+        return _ALIASES.get(value.strip().lower())
+    return None
+
+
+def fallback_policy_from_entries(task: Any, entries: Iterable[Mapping[str, Any]]) -> str:
+    """Policy stored on the matching registration entry; native when absent, invalid fails closed."""
+    if not task:
+        return NATIVE
+    wanted = str(task)
+    for entry in entries:
+        if entry.get("key") == wanted:
+            raw = entry.get("fallback_policy")
+            if raw is None:
+                return NATIVE
+            policy = normalize_fallback_policy(raw)
+            if policy is None:
+                raise InvalidFallbackPolicyError(
+                    f"Auxiliary task {wanted!r} has invalid registered fallback_policy {raw!r}")
+            return policy
+    return NATIVE
+
+
+def registered_fallback_policy(task: Any) -> str:
+    """Current trusted policy for ``task`` (native for built-ins and unregistered keys).
+
+    A registry read failure propagates: defaulting to native here would silently widen a strict
+    task back onto ambient recovery.
+    """
+    if not task:
+        return NATIVE
+    from hermes_cli.plugins import get_plugin_auxiliary_tasks
+    return fallback_policy_from_entries(task, get_plugin_auxiliary_tasks())
+
+
+def strict_route_validation_error(
+    task_config: Mapping[str, Any], *, provider: Any = None, model: Any = None,
+) -> Optional[str]:
+    """Why a ``configured_only`` task's route may not dispatch, or ``None`` when it is valid.
+
+    The primary pair only has to be string-typed here (its presence/auto rules stay with the
+    existing effective-route guard); every configured fallback entry must name an explicit
+    provider and model, because the legacy entry resolver accepts ``auto``.
+    """
+    for field, value in (("provider", task_config.get("provider")),
+                         ("model", task_config.get("model")),
+                         ("provider", provider), ("model", model)):
+        if value is not None and not isinstance(value, str):
+            return f"{field} must be a string"
+    chain = task_config.get("fallback_chain")
+    if chain is None:
+        return None
+    if not isinstance(chain, list):
+        return "fallback_chain must be a list"
+    for i, entry in enumerate(chain):
+        if not isinstance(entry, ABCMapping):
+            return f"fallback_chain[{i}] must be a mapping"
+        for field in ("provider", "model"):
+            value = entry.get(field)
+            if not isinstance(value, str):
+                return f"fallback_chain[{i}].{field} must be a string"
+            if not value.strip() or value.strip().lower() == "auto":
+                return f"fallback_chain[{i}].{field} must be an explicit provider or model"
+    return None
+
+
+def is_configured_only_task(task: Any) -> bool:
+    return registered_fallback_policy(task) == CONFIGURED_ONLY
+
+
+def missing_configured_route_message(task: Any) -> str:
+    return (f"Auxiliary task {str(task)!r} requires an explicit configured provider and model "
+            f"(fallback_policy='{CONFIGURED_ONLY}')")
+
+
+def configured_only_preflight_error(
+    task: Any, task_config: Mapping[str, Any], *, provider: Any = None,
+    model: Any = None, effective_provider: Any = None,
+    resolved_model: Any = None,
+) -> Optional[str]:
+    """Blocking preflight error for a ``configured_only`` task's route, or ``None``.
+
+    Runs before any client is built so a strict task can never dispatch onto ambient recovery.
+    Native/default and unregistered tasks always pass; the route type/chain checks and the
+    effective provider/model guard stay together so no call site can skip one of them.
+    """
+    if not is_configured_only_task(task):
+        return None
+    route_error = strict_route_validation_error(task_config, provider=provider, model=model)
+    if route_error:
+        return f"{missing_configured_route_message(task)}: {route_error}"
+    eff_provider = str(effective_provider or "").strip()
+    eff_model = str(resolved_model or "").strip()
+    if (eff_provider.lower() in {"", "auto"} or not eff_model
+            or eff_model.lower() == "auto"):
+        return missing_configured_route_message(task)
+    return None
diff --git a/agent/auxiliary_fallback_recovery.py b/agent/auxiliary_fallback_recovery.py
index d479845e534..1ff6002a7b9 100644
--- a/agent/auxiliary_fallback_recovery.py
+++ b/agent/auxiliary_fallback_recovery.py
@@ -1,12 +1,20 @@
-"""Parameter-rejection recovery for auxiliary fallback candidates.
+"""Fallback candidate selection and parameter-rejection recovery for auxiliary requests.
 
 The primary auxiliary request runs the full recovery ladder in ``auxiliary_client``; a fallback
 candidate (per-task chain, main fallback chain, discovery) used to get a single shot, so a fallback
 model that rejects ``temperature``, ``max_tokens`` or a reasoning field failed the whole task even
 though the same parameter rungs would have recovered it on the primary path (#78273, #72351).
 This module runs those rungs — and only those — around a candidate's request.
+
+It also owns the ``configured_only`` strict chain. It reads every facade global late through
+``agent.auxiliary_client`` so the historical patch targets on that module keep working.
 """
-from typing import Any, Awaitable, Callable, Dict, Optional
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any, Awaitable, Callable, Dict, Optional
+
+if TYPE_CHECKING:
+    from agent.auxiliary_client import _LadderRoute
 
 
 def _parameter_ladder(first_err: Exception, client: Any, kwargs: dict[str, Any], *,
@@ -48,3 +56,50 @@ async def send_with_parameter_rungs_async(
     except Exception as first_err:
         ladder = _parameter_ladder(first_err, client, kwargs, task=task, tag=" (async)")
         return await _drive_ladder_async(ladder, lambda step: send(*step.args))
+
+
+def strict_provider_fallback(first_err: Exception, route: _LadderRoute):
+    """``configured_only`` recovery: the task's own ``fallback_chain`` only, then STOP.
+
+    No credential refresh, main-model, payment/discovery or main-chat rescue is reachable from
+    here; callers re-raise the primary (narrowed) error once the configured chain is exhausted.
+    """
+    from agent import auxiliary_client as ac
+    from agent.backend_identity import FailureScope
+
+    task, resolved_provider = route.task, route.resolved_provider
+    reason = next((label for predicate, label in ac._FALLBACK_REASONS if predicate(first_err)), None)
+    if reason is None:
+        return None
+    # Mirrors the ambient rung's failed-model scoping: auth/payment are provider-wide, model
+    # failures skip only the deployment that failed.
+    chain_failed_model = None if reason in ("auth error", "payment error") else route.final_model
+    chain_failure_scope = (
+        FailureScope.ENDPOINT
+        if reason == "payment error" and ac._custom_health_base_url(resolved_provider, route.base_info)
+        else None
+    )
+    fb_client, fb_model, fb_label = ac._try_configured_fallback_chain(
+        task, resolved_provider or "auto", reason=reason, failed_model=chain_failed_model,
+        failed_base_url=route.base_info, failure_scope=chain_failure_scope)
+    tried_lanes: set = set()
+    primary_route = dict(route.route_info) if route.route_info is not None else None
+    while fb_client is not None:
+        lane = (fb_label, fb_model, str(getattr(fb_client, "base_url", "") or ""))
+        if lane in tried_lanes:
+            break
+        tried_lanes.add(lane)
+        ac._record_route_info(route.route_info, ac._fallback_provider_from_label(fb_label), fb_model)
+        fb_resp = yield ac._LadderStep("fallback", (fb_client, fb_model, fb_label))
+        if fb_resp is not None:
+            return fb_resp
+        fb_client, fb_model, fb_label = ac._next_fallback_after_quarantine(
+            task, resolved_provider, False, route, chain_failed_model, chain_failure_scope,
+            task_chain_only=True)
+    if primary_route is not None and route.route_info is not None:
+        route.route_info.update(primary_route)
+    ac.logger.warning("Auxiliary %s%s: %s on %s and its configured fallback_chain is exhausted "
+                      "(configured_only). Raising the primary error.",
+                      task or "call", route.tag, reason, resolved_provider)
+    return None
+
